{
  "name": "enshrouded-mods",
  "private": true,
  "type": "module",
  "description": "Commit message linting and markup formatting for the mods repository. The project itself is Rust.",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "prepare": "bun ./node_modules/lefthook/bin/index.js install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
